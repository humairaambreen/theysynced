# ── TheySynced Backend Environment Variables ────────────────────────────────

# REQUIRED: Turso (libSQL) remote database
# Get these from: turso db create theysynced && turso db tokens create theysynced
TURSO_DATABASE_URL=libsql://theysynced-<your-org>.turso.io
TURSO_AUTH_TOKEN=<your-turso-auth-token>

# REQUIRED: JWT signing secret (use a long random string: openssl rand -base64 32)
JWT_SECRET=change-this-to-a-long-random-secret-string

# REQUIRED: Master AES-256-GCM encryption secret for data-at-rest
ORG_ENCRYPTION_SECRET=change-this-to-a-secure-master-encryption-secret

# OPTIONAL: Cron authentication secret for edge trigger verification
CRON_SECRET=change-this-to-a-secure-cron-secret

# OPTIONAL: Server bind settings (defaults shown)
HOST=0.0.0.0
PORT=8000

# OPTIONAL: Logging level
RUST_LOG=info

# ── Cloudflare Edge Worker & Frontend Configuration ──────────────────────────
# Upstream Rust backend URL (forwarding destination for worker/index.js)
BACKEND_URL=http://localhost:8000

# Client-facing API and tunnel URLs (Next.js public env vars)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_TUNNEL_URL=
